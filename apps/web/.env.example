# Server-only upstream. All browser API calls use the same-origin /backend proxy.
API_BASE_URL="http://127.0.0.1:4000"
AUTH_SESSION_COOKIE_NAME="piggybanq_wallet_session"

# Production: API_BASE_URL="https://your-piggybanq-api.example.com"
# Set at build AND runtime; rebuild/redeploy after changing the upstream.
# AUTH_SESSION_COOKIE_NAME must match the API setting.
