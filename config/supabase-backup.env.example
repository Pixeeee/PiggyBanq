# Copy to ~/.config/piggybanq/supabase-backup.env with chmod 600.
# Read-only backup login, copied from the project's direct/session connection details.
# URL-encode the password. Never use the transaction pooler on port 6543.
SUPABASE_BACKUP_URL="postgresql://piggybanq_backup.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST.supabase.com:5432/postgres?sslmode=verify-full"
SUPABASE_BACKUP_SCHEMA="piggybanq"
# Match the source server's major version; the restore container uses this too.
SUPABASE_BACKUP_PG_MAJOR="17"

# Absolute path to the official Supabase CA certificate (required for Supavisor).
SUPABASE_BACKUP_CA_FILE="/absolute/path/to/config/supabase-ca.crt"
