{
  "name": "@piggybanq/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "db:migrate": "node --env-file=.env.migrations node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@piggybanq/stellar-core": "workspace:*",
    "@piggybanq/types": "workspace:*",
    "@prisma/client": "^6.0.0",
    "@stellar/stellar-sdk": "^17.0.1",
    "@x402/stellar": "2.28.0",
    "fastify": "^5.12.6",
    "tsx": "^4.19.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "prisma": "^6.0.0"
  }
}
