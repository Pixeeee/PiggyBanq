generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LedgerEventType {
  DEPOSIT
  WITHDRAWAL
  POCKET_CREATED
  POCKET_CREDIT
  POCKET_DEBIT
  DEPOSIT_PLANNED
  DEPOSIT_CONFIRMED
  LOCK_STARTED
  YIELD_ACCRUED
  WITHDRAWAL_PLANNED
  WITHDRAWAL_CONFIRMED
  PAYMENT_SENT
  PAYMENT_RECEIVED
  TRUSTLINE_CREATED
  MILESTONE_GRANTED
}

enum AnchorSessionType {
  DEPOSIT
  WITHDRAWAL
}

enum AnchorSessionStatus {
  PENDING
  COMPLETE
  FAILED
  EXPIRED
}

enum Visibility {
  PUBLIC
  WALLET_ADDRESS_ONLY
  PRIVATE
}

enum ChatChannelType {
  GLOBAL
  PRIVATE
  GROUP
}

enum AuthChallengePurpose {
  SIGN_UP
  LOGIN
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum AgentActionType {
  X402_PAYMENT
  STELLAR_SWAP
  CCTP_BRIDGE
  STELLAR_SELL
}

enum AgentActionProvider {
  BINANCE_X402
  STELLAR
  CIRCLE_CCTP
  STELLAR_ANCHOR_SANDBOX
}

enum AgentActionStatus {
  AWAITING_APPROVAL
  APPROVED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StellarTransactionType {
  PAYMENT
  CHANGE_TRUST
  PATH_PAYMENT_STRICT_SEND
}

enum StellarTransactionStatus {
  QUOTED
  AWAITING_SIGNATURE
  EXECUTING
  SUBMITTED
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
  UNKNOWN
}

model User {
  id              String            @id @default(cuid())
  username        String?           @unique
  email           String?           @unique
  passwordHash    String?
  stellarPublicKey String?          @unique
  displayName     String
  role            UserRole          @default(USER)
  status          UserStatus        @default(ACTIVE)
  avatarUrl       String?
  bio             String?
  coverPhotoUrl   String?
  currency        String            @default("PHP")
  themePreference String            @default("light")
  visibility      Visibility        @default(PRIVATE)
  lastLoginAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  wallets         WalletAccount[]
  pockets         SavingsPocket[]
  ledgerEvents    LedgerEvent[]
  budgetPlans     BudgetPlan[]
  reliefPosts     ReliefPost[]
  pledges         Pledge[]
  groupMemberships GroupMembership[]
  posts           Post[]
  comments        Comment[]
  messages        ChatMessage[]
  userMilestones  UserMilestone[]
  sessions        Session[]
  walletAuthChallenges WalletAuthChallenge[]
  refreshTokens   RefreshToken[]
  mfaSecret       MfaSecret?
  auditLogs       AuditLogEntry[]
  agentActions    AgentAction[]
  stellarTransactions StellarTransactionIntent[]
  x402Payments    X402Payment[]
}

model X402Payment {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  idempotencyKey    String   @map("idempotency_key")
  status            String   @default("AWAITING_APPROVAL")
  payer             String
  payTo             String   @map("pay_to")
  amountUnits       BigInt   @map("amount_units")
  requirements      Json
  payload           Json?
  authorizationHash String?  @unique @map("authorization_hash")
  transactionHash   String?  @unique @map("transaction_hash")
  settlementXdr     String?  @db.Text @map("settlement_xdr")
  receipt           Json?
  errorCode         String?  @map("error_code")
  expiresAt         DateTime @map("expires_at")
  approvedAt        DateTime? @map("approved_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, approvedAt])
  @@index([status, updatedAt])
  @@map("agent_x402_payments")
}

model WalletAuthChallenge {
  id            String               @id @default(cuid())
  publicKey     String
  nonceHash     String
  messageHash   String
  message       String
  purpose       AuthChallengePurpose
  network       String
  domain        String
  issuedAt      DateTime
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime             @default(now())
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publicKey, purpose, usedAt])
  @@index([expiresAt])
}

model WalletAccount {
  id        String   @id @default(cuid())
  userId    String
  publicKey String   @unique
  label     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavingsPocket {
  id             String        @id @default(cuid())
  userId         String
  label          String
  assetCode      String
  targetMinor    BigInt?
  pocketType     String        @default("FLEXIBLE")
  status         String        @default("ACTIVE")
  principalMinor BigInt?
  apyBps         Int?
  lockDays       Int?
  lockedAt       DateTime?
  maturesAt      DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         LedgerEvent[]

  @@index([userId, assetCode])
  @@index([userId, status])
}

model LedgerEvent {
  id              String          @id @default(cuid())
  userId          String
  savingsPocketId String?
  type            LedgerEventType
  assetCode       String
  amountMinor     BigInt
  externalTxHash  String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  savingsPocket   SavingsPocket?  @relation(fields: [savingsPocketId], references: [id])

  @@index([userId, createdAt])
  @@index([externalTxHash])
}

model BudgetPlan {
  id              String           @id @default(cuid())
  userId          String
  month           String
  displayCurrency String
  totalMinor      BigInt
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories      BudgetCategory[]

  @@unique([userId, month])
}

model BudgetCategory {
  id             String     @id @default(cuid())
  budgetPlanId   String
  name           String
  allocationBps  Int
  fixedMinor     BigInt?
  pinnedAsset    String?
  sortOrder      Int        @default(0)
  budgetPlan     BudgetPlan @relation(fields: [budgetPlanId], references: [id], onDelete: Cascade)
}

model AnchorSession {
  id             String              @id @default(cuid())
  userId         String
  type           AnchorSessionType
  status         AnchorSessionStatus @default(PENDING)
  assetCode      String
  anchorHomeDomain String
  interactiveUrl String?
  externalId     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, status])
}

model ReliefPost {
  id              String    @id @default(cuid())
  authorId        String
  description     String
  photoUrl         String?
  locationTag      String?
  targetAmountMinor BigInt?
  assetCode        String?
  createdAt        DateTime  @default(now())
  author           User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pledges          Pledge[]
}

model Pledge {
  id              String     @id @default(cuid())
  reliefPostId    String
  userId          String
  amountMinor     BigInt
  assetCode       String
  createdAt       DateTime   @default(now())
  reliefPost      ReliefPost @relation(fields: [reliefPostId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reliefPostId])
}

model Group {
  id          String            @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime          @default(now())
  memberships GroupMembership[]
  posts       Post[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Post {
  id        String    @id @default(cuid())
  groupId   String?
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  group     Group?    @relation(fields: [groupId], references: [id])
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model ChatChannel {
  id        String          @id @default(cuid())
  type      ChatChannelType
  name      String?
  createdAt DateTime        @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  channelId String
  senderId  String
  body      String
  createdAt DateTime    @default(now())
  channel   ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User        @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model Milestone {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  description    String
  createdAt      DateTime        @default(now())
  userMilestones UserMilestone[]
}

model UserMilestone {
  id          String    @id @default(cuid())
  userId      String
  milestoneId String
  grantedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

model Perk {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String
  createdAt   DateTime @default(now())
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  ipAddress  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash, expiresAt, revokedAt])
}

model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  tokenHash    String    @unique
  familyId     String
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
}

model MfaSecret {
  id              String   @id @default(cuid())
  userId          String   @unique
  encryptedSecret String
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AgentAction {
  id              String              @id @default(cuid())
  userId          String
  actionType      AgentActionType
  provider        AgentActionProvider
  status          AgentActionStatus   @default(AWAITING_APPROVAL)
  requestPayload  Json
  policyResult    Json
  expiresAt       DateTime
  approvedAt      DateTime?
  executedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt         ProviderReceipt?

  @@index([userId, createdAt])
  @@index([userId, status])
}

model ProviderReceipt {
  id                String      @id @default(cuid())
  agentActionId     String      @unique
  network           String
  externalReference String
  providerPayload   Json
  createdAt         DateTime    @default(now())
  agentAction       AgentAction @relation(fields: [agentActionId], references: [id], onDelete: Cascade)
}

model StellarTransactionIntent {
  id                       String                   @id @default(cuid())
  userId                   String
  idempotencyKey           String
  requestHash              String
  operationType            StellarTransactionType
  status                   StellarTransactionStatus @default(QUOTED)
  network                  String                   @default("STELLAR_TESTNET")
  sourcePublicKey          String
  destinationPublicKey     String?
  assetCode                String
  assetIssuer              String?
  amountUnits              String
  destinationAssetCode     String?
  destinationAssetIssuer   String?
  minimumDestinationUnits  String?
  feeStroops               String
  memo                     String?
  path                     Json?
  requestPayload           Json
  reviewPayload            Json
  policyResult             Json
  unsignedXdr              String                   @db.Text
  unsignedBodyHash         String
  signedXdr                String?                  @db.Text
  transactionHash          String?
  errorCode                String?
  errorDetail              String?
  expiresAt                DateTime
  approvedAt               DateTime?
  executionStartedAt       DateTime?
  submittedAt              DateTime?
  reconciledAt             DateTime?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([transactionHash])
}
