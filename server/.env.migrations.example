# Local administrator credentials for migrations only. Match your database owner.
# Copy to .env.migrations, replace the password, and restrict the file to mode 600.
DATABASE_URL="postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@127.0.0.1:5432/piggybanq?sslmode=disable"
DIRECT_URL="postgresql://postgres:REPLACE_WITH_ADMIN_PASSWORD@127.0.0.1:5432/piggybanq?sslmode=disable"
