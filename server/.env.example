# Local runtime: provision the restricted role using prisma/runtime-role.sql.
# Generate a private password; never use the administrator login for the API.
DATABASE_URL="postgresql://piggybanq_app:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/piggybanq?sslmode=disable"
DIRECT_URL="postgresql://piggybanq_app:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/piggybanq?sslmode=disable"
# Keep administrator URLs in a separate private .env.migrations file.
# See docs/database-operations.md; use pnpm --filter @piggybanq/server db:migrate.

# Supabase: private piggybanq schema, restricted piggybanq_app login only.
# Runtime DATABASE_URL uses the transaction pooler (6543), with pgbouncer=true,
# schema=piggybanq, sslmode=require and sslaccept=strict (Prisma 6),
# plus the provider's CA as needed. Backup libpq uses sslmode=verify-full.
# DIRECT_URL on the API must use the SAME restricted role, never the migration owner.
# Owner credentials belong only in the operator's private .env.migrations.
PORT=4000
HOST=127.0.0.1
# Set only for a sanitizing reverse proxy; IP/CIDR list or validated hop count.
# TRUST_PROXY=loopback

AUTH_APP_NAME="PiggyBanq"
AUTH_APP_URL="http://127.0.0.1:3010"
AUTH_ALLOWED_ORIGINS="http://127.0.0.1:3010,http://localhost:3010"
AUTH_DOMAIN="127.0.0.1:3010"
AUTH_ALLOWED_STELLAR_NETWORKS="TESTNET"
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800
AUTH_SESSION_COOKIE_NAME="piggybanq_wallet_session"
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW="1 minute"
AUTH_SENSITIVE_RATE_LIMIT_MAX=10

# Agentic integrations remain sandboxed unless explicitly enabled.
AGENTIC_PROVIDER_MODE="sandbox"
STELLAR_NETWORK="TESTNET"
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_FRIENDBOT_URL="https://friendbot.stellar.org"
STELLAR_FRIENDBOT_ENABLED=true
STELLAR_QUOTE_TTL_SECONDS=300
STELLAR_MAX_PAYMENT_AMOUNT="1000000"
STELLAR_MAX_SWAP_AMOUNT="100000"
STELLAR_MAX_TRUSTLINE_LIMIT="1000000"
STELLAR_EMERGENCY_READ_ONLY=false
STELLAR_QUOTE_RATE_LIMIT_MAX=12
STELLAR_SUBMIT_RATE_LIMIT_MAX=6
CCTP_SOURCE_DOMAIN=27
CCTP_DESTINATION_DOMAIN=6
BINANCE_X402_ENABLED=false
# Native Stellar x402 test API. Sponsor key is a separate disposable Testnet account.
STELLAR_X402_ENABLED=false
# STELLAR_X402_FACILITATOR_SECRET=""
# STELLAR_X402_PAY_TO="G..."
# Apply through Binance x402 partner onboarding before setting these server-only values.
# BINANCE_X402_BASE_URL="https://sandbox-provider-url.example"
# BINANCE_X402_CLIENT_ID=""
# BINANCE_X402_SIGN_ACCESS_TOKEN=""
# BINANCE_X402_PRIVATE_KEY_BASE64=""
